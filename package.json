{
  "name": "paceiq",
  "version": "1.0.0",
  "description": "AI Running Coach powered by Notion MCP — MLH × Notion MCP Challenge",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "setup": "node --loader ts-node/esm src/notion/setup.ts",
    "sync": "node --loader ts-node/esm src/strava/sync.ts",
    "start": "node --loader ts-node/esm src/index.ts",
    "report": "node --loader ts-node/esm src/agent/weekly_report.ts",
    "build": "tsc",
    "lint": "npx --yes --package eslint@9.39.2 --package @eslint/js@9.39.2 --package typescript-eslint@8.46.2 --package eslint-config-prettier@10.1.8 eslint .",
    "lint:fix": "npx --yes --package eslint@9.39.2 --package @eslint/js@9.39.2 --package typescript-eslint@8.46.2 --package eslint-config-prettier@10.1.8 eslint . --fix",
    "format": "npx --yes prettier@3.7.4 . --check",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test --loader ts-node/esm tests/**/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.4.9",
    "@notionhq/client": "^2.2.15",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "ora": "^8.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "notion",
    "mcp",
    "running",
    "ai-coach",
    "strava",
    "langchain"
  ],
  "license": "MIT"
}
