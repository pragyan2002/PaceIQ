# Notion — create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=               # Integration token (secret_...)
NOTION_PARENT_PAGE_ID=        # Parent page ID where setup will create PaceIQ databases

# OpenRouter — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=           # API key used by the coaching agent

# Strava — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=             # Strava API application client ID
STRAVA_CLIENT_SECRET=         # Strava API application client secret
STRAVA_REFRESH_TOKEN=         # OAuth refresh token used for activity sync

# Sync behavior
STRAVA_SYNC_DAYS=30           # Days back to import on each sync

# Notion DB IDs — printed by `npm run setup`
NOTION_RUNS_DB_ID=            # PaceIQ Runs database ID
NOTION_LOG_DB_ID=             # PaceIQ Training Log database ID
NOTION_RACES_DB_ID=           # PaceIQ Races database ID
NOTION_SESSIONS_DB_ID=        # PaceIQ Coach Sessions database ID
NOTION_REPORTS_DB_ID=         # PaceIQ Weekly Reports database ID

# n8n ↔ PaceIQ shared secret for /notion-chat
NOTION_CHAT_SECRET=           # Optional but recommended; required if n8n sends X-Notion-Chat-Secret

# Server
PORT=3000                     # Optional HTTP port for the API server
